# 5fing3rs 3D Printing Cost Estimator - Environment Variables

# DATABASE CONFIGURATION
# ----------------------
# Database URL for SQLAlchemy (Example: postgresql://user:password@host:port/dbname)
DATABASE_URL=postgresql://printuser:print123@localhost:5433/printing_platform

# Postgres specific (for Docker setup)
POSTGRES_USER=printuser
POSTGRES_PASSWORD=print123
POSTGRES_DB=printing_platform

# AUTHENTICATION CONFIGURATION
# ----------------------------
# Secret key for JWT signing (Change this in production!)
SECRET_KEY=your-secret-key-change-in-production
# JWT algorithm
ALGORITHM=HS256
# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CURAENGINE CONFIGURATION
# ------------------------
# Hostname or IP of the CuraEngine service
CURA_ENGINE_HOST=localhost
# Path to the CuraEngine binary
CURA_ENGINE_PATH=/usr/bin/CuraEngine
# Path to the printer definition file
PRINTER_DEF_PATH=./cura-engine/fdmprinter.def.json

# EMAIL CONFIGURATION (MAILTRAP)
# ------------------------------
# Mailtrap API Token (Required for sending emails)
MAILTRAP_API_TOKEN=
# Mailtrap API URL
MAILTRAP_API_URL=https://send.api.mailtrap.io/api
# Sender email address
MAILTRAP_FROM_EMAIL=noreply@fivefingers.com
# Sender name
MAILTRAP_FROM_NAME="3D Printing Platform"

# FRONTEND CONFIGURATION
# ----------------------
# Backend API URL for Vite
VITE_API_URL=http://localhost:8000
