# Backend Environment Variables

# Database Connection
DATABASE_URL=postgresql://printuser:print123@db:5432/printing_platform

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CuraEngine Integration
CURA_ENGINE_HOST=cura-engine
CURA_ENGINE_PATH=/usr/bin/CuraEngine
PRINTER_DEF_PATH=/app/cura-engine/fdmprinter.def.json

# Mailtrap Email Service
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api
MAILTRAP_FROM_EMAIL=noreply@fivefingers.com
MAILTRAP_FROM_NAME="3D Printing Platform"
